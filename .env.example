# ── Supabase (retired: the app now runs on Neon, see the Neon section below) ─
# Project settings > API. The reporting platform and the Hub share one project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Locally http://localhost:3000; in production your deployed URL.
NEXT_PUBLIC_SITE_URL=

# ── Africa's Talking ────────────────────────────────────────────────────────
# USSD confirmation SMS, sent by /api/ussd/events when a session ends.
# Sandbox: username "sandbox" plus the sandbox API key.
# Leave unset to disable SMS — the USSD report still saves.
AT_USERNAME=
AT_API_KEY=

# ── OpenRouter ──────────────────────────────────────────────────────────────
# Powers the in-app resource assistant (/api/chat). Leave unset to disable it.
OPENROUTER_API_KEY=
# Optional; defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=

# ── Meta (online listening) ─────────────────────────────────────────────────
# Facebook Page monitoring. Leave unset to disable the feature;
# /hub/reporting/listening then shows a "not connected" state.
#
# Note: an App ID and App Secret from the Meta dashboard are NOT enough on
# their own. Those give an *app* access token, which cannot read a Page feed.
# META_PAGE_ACCESS_TOKEN must be a long-lived *Page* token — see SETUP.md.
# "Test connection" on the listening page reports exactly which part is missing.
# META_APP_ID is optional but recommended: with it, "Test connection" can also
# report the token's scopes and how long it has left before expiring.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# ── Legacy ──────────────────────────────────────────────────────────────────
# The standalone reporting deployment. No longer used for navigation — the
# reporting platform is part of this app. Safe to remove once it is retired.
NEXT_PUBLIC_REPORTING_URL=
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# ── Social link listening ──────────────────────────────────────────────────
# Instagram posts are read through Apify; X posts through X's public embed (no key).
# APIFY_TOKEN=
# SOCIAL_DAILY_CAP=60
# SOCIAL_PROVIDER=off   # kill switch

TYPESAFE_API_KEY=
# ── Urgent-case alerts ─────────────────────────────────────────────────────
# Web push (generate with: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tech@whrdhub.org
# Second-line recipients for cases nobody acknowledged (comma-separated emails)
# ESCALATION_EMAILS=
# Protects /api/cron/escalate-reports (Vercel sends it as a Bearer token)
# CRON_SECRET=
# Mailtrap token for escalation emails
# MAILTRAP_SENDING_TOKEN=

# ── Map tiles ──────────────────────────────────────────────────────────────
# CARTO Voyager basemap key for the incident map. Without it the map falls back to the keyless light style.
# NEXT_PUBLIC_CARTO_API_KEY=

# ── Encryption of sensitive data (REQUIRED to file or read reports) ─────────
# Report narrative, contact details, exact location and USSD phone numbers are
# encrypted with AES-256-GCM before they reach the database. Keep these ONLY in
# the server environment (Vercel), never in the database or the repository.
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Format: keyId:base64key. List older keys after the new one so old rows still open.
# DATA_ENCRYPTION_KEYS=k1:<base64 32-byte key>
# DATA_ENCRYPTION_ACTIVE=k1
# Keyed fingerprint so a phone number can be looked up without storing it.
# Generate the same way. NEVER change it once reports exist.
# BLIND_INDEX_KEY=<base64 32+ byte key>


# ── Neon (database, sign-in, stored files) ─────────────────────────────────
# Written into .env.local by `neon env pull` / `neon deploy`. On Vercel, add them by hand.
# DATABASE_URL=                  # pooled; not used by the app at runtime today
# DATABASE_URL_UNPOOLED=         # direct; for schema work and loads only
# NEON_AUTH_BASE_URL=            # Neon Auth for this branch
# NEON_DATA_API_URL=             # Neon Data API (server side)
# NEXT_PUBLIC_NEON_DATA_API_URL= # the same address, for the browser
# AWS_ACCESS_KEY_ID=             # Neon Object Storage (S3-compatible)
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
#
# Signs the session cache cookie. 32+ characters, different in every environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEON_AUTH_COOKIE_SECRET=
#
# The server's own account on Neon Auth. It replaces the old service-role key and is
# just as sensitive: server only, never NEXT_PUBLIC_. See supabase/neon/04_service_and_accounts.sql.
# NEON_SERVICE_EMAIL=
# NEON_SERVICE_PASSWORD=

# ── Copy of uploaded files in Google Drive (optional) ──────────────────────
# Off unless all three are set. The folder must be in a Shared Drive with the
# service account added as Content manager. See lib/storage/google-backup.ts.
# GOOGLE_BACKUP_CLIENT_EMAIL=
# GOOGLE_BACKUP_PRIVATE_KEY=
# GOOGLE_BACKUP_FOLDER_ID=
# Private files (report evidence, mentor documents) are copied only if this is "true".
# GOOGLE_BACKUP_INCLUDE_PRIVATE=
